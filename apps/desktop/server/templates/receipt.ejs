<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>Receipt</title>
    <style>
        body { font-family: Arial, sans-serif; color: #222; margin: 0; padding: 24px; }
        h1 { margin: 0 0 8px; font-size: 22px; }
        .meta { color: #666; font-size: 13px; margin-bottom: 20px; }
        table { width: 100%; border-collapse: collapse; margin-top: 16px; }
        th, td { border-bottom: 1px solid #ddd; padding: 8px; text-align: left; font-size: 13px; }
        .total { font-size: 16px; font-weight: bold; margin-top: 16px; }
    </style>
</head>
<body>
    <h1><%= title %></h1>
    <div class="meta">
        <div><%= company.name %></div>
        <div><%= company.address %></div>
        <div><%= company.phone %></div>
        <div>Date: <%= date %></div>
        <% if (orderNumber) { %><div>Order #<%= orderNumber %></div><% } %>
        <% if (customerName) { %><div>Customer: <%= customerName %></div><% } %>
    </div>
    <p><%= description %></p>
    <div class="total">Amount: Rs <%= amount.toLocaleString() %></div>
</body>
</html>
