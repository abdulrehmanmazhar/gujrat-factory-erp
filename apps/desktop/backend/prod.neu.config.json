{
    "applicationId": "app.neutralino.vite",
    "binaryName": "GUJRAT FACTORY ERP",
    "defaultMode": "window",
    "documentRoot": "/dist/",
    "url": "/index.html",
    "enableServer": true,
    "port": 0,
    "singlePageServe": true,
    "enableNativeAPI": true,
    "nativeAllowList": ["app.*", "os.*", "filesystem.*", "storage.*", "window.*", "events.*", "debug.*", "extensions.*", "updater.*", "clipboard.*"],
    "modes": {
        "window": {
            "title": "GUJRAT FACTORY ERP",
            "width": 1200,
            "height": 800,
            "icon": "/icon.png",
            "injectGlobals": true,
            "exitProcessOnClose": false
        }
    },
    "cli": {
        "resourcesPath": "/dist/"
    }
}
